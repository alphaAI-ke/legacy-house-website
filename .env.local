ADMIN_SESSION_SECRET=

# AI chatbot — prefer Anthropic, but NVIDIA can be used as a fallback.
# Get an Anthropic key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional fallback when ANTHROPIC_API_KEY is missing.
# NVIDIA key from https://build.nvidia.com/
