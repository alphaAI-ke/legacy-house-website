# Copy this file to .env.local and fill in real values before running locally or deploying.

# Admin panel (used at /admin) — change these before going live.
ADMIN_PASSWORD=changeme123
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# AI chatbot — prefer Anthropic, but NVIDIA can be used as a fallback.
# Get an Anthropic key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional fallback when ANTHROPIC_API_KEY is missing.
# NVIDIA key from https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Optional: lets the admin panel actually email replies to parents.
# If left blank, replies are still saved and shown in the admin panel,
# with a "mailto" fallback link instead of an automatic send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
